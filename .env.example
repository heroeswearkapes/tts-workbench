#################################
# TTS Workbench Docker Compose
#################################

# Docker image
IMAGE_NAME=heroeswearkapes/tts-workbench
IMAGE_TAG=latest


#################################
# Network
#################################

# Gradio web interface port
TTS_PORT=7860


#################################
# Persistent Storage
#################################

# Change this to match your system

# Linux example:
# TTS_DATA_ROOT=/opt/tts-workbench

# Windows Docker Desktop example:
# TTS_DATA_ROOT=C:/tts-workbench

# Unraid example:
# TTS_DATA_ROOT=/mnt/user/AI/tts-workbench

TTS_DATA_ROOT=/opt/tts-workbench


# Application configuration

# Linux:
# CONFIG_PATH=/opt/tts-workbench/config

# Windows:
# CONFIG_PATH=C:/tts-workbench/config

# Unraid:
# CONFIG_PATH=/mnt/user/appdata/tts-workbench/config

CONFIG_PATH=/opt/tts-workbench/config


#################################
# Intel XPU Support
#################################

# Set false for CPU-only systems
ENABLE_XPU=true

# Linux / Unraid Intel GPU device
XPU_DEVICE=/dev/dri/renderD131